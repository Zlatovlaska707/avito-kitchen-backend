# Copy to .env and adjust for local development.
# Secrets are not stored in config/config.yaml — only in environment.

APP_ENV=local
HTTP_ADDRESS=:8080

POSTGRES_DSN=postgres://kitchen:kitchen@localhost:5432/kitchen?sslmode=disable
ADMIN_API_TOKEN=local-admin-token-change-me

MIGRATIONS_AUTO_RUN=false
MIGRATIONS_DIR=./migrations

WEBHOOK_ALLOW_PRIVATE_IPS=true
WORKERS_ENABLED=true

SEED_PARTNER_API_KEY=ak_demopizz_xK9mN2pQ7vR4wL8hT3jF6sD1aB0cE5gY9uI2oP4

LOG_LEVEL=info
LOG_FORMAT=json
DEFAULT_TIMEZONE=Europe/Moscow

OPENAPI_VALIDATE_REQUESTS=true
